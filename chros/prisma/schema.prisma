generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Side {
	COOL
	HOT
}

enum Half {
	FIRST
	SECOND
}

model Participant {
	id Int @id @default(autoincrement())
	name String

	coolScores Score[] @relation("ScoreCool")
	hotScores Score[] @relation("ScoreHot")

	matchesAsAgent1 Match[] @relation("Agent1Matches")
	matchesAsAgent2 Match[] @relation("Agent2Matches")
	wins Match[] @relation("WinnerMatches")
}

model Match {
	id Int @id @default(autoincrement())
	name String?
	agent1Id Int
	agent2Id Int
	winnerId Int?

	agent1 Participant @relation("Agent1Matches", fields: [agent1Id], references: [id])
	agent2 Participant @relation("Agent2Matches", fields: [agent2Id], references: [id])
	winner Participant?@relation("WinnerMatches", fields: [winnerId], references: [id])

	scores Score[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([agent1Id])
	@@index([agent2Id])
	@@index([winnerId])
}

model Score {
	id Int @id @default(autoincrement())

	matchId Int
	match Match @relation(fields: [matchId], references: [id])

	half Half

	coolId Int
	cool Participant @relation("ScoreCool", fields: [coolId], references: [id])

	hotId Int
	hot Participant @relation("ScoreHot", fields: [hotId], references: [id])

	coolScore Int
	hotScore Int

	put Side?
	lostConnect Side?

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([matchId, half])
	@@index([coolId])
	@@index([hotId])
}
